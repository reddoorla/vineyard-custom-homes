{
  "id": "page",
  "label": "Page",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "heading1"
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Hero image (home page; shown until the video plays; a frame from the video's opening avoids a jump)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "hero_vimeo_id": {
        "type": "Text",
        "config": {
          "label": "Hero Vimeo ID (home page)",
          "placeholder": "The number in the video's Vimeo link, e.g. 1092190178. Empty keeps today's video."
        }
      },
      "second_hero_image": {
        "type": "Image",
        "config": {
          "label": "Second video image (home page, behind 'View our work'; its video is 'vimeo id for video')",
          "constraint": {},
          "thumbnails": []
        }
      },
      "vimeo_id_for_video": {
        "type": "Text",
        "config": {
          "label": "vimeo id for video",
          "placeholder": ""
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
